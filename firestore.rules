rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // Stores collection:
    // Public can read stores (needed to display store info, branding, social links)
    // Only authenticated admin can create/update/delete stores
    match /stores/{storeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users collection:
    // User can read their own profile, admin can read/write
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Products collection:
    // Public users can read products for the storefront catalog
    // Only authenticated admins can create, update, and delete products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories collection:
    // Public can read categories
    // Admin can create, update, delete categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Clicks collection:
    // Anyone (even public storefront visitors who click "Buy Now") can create click logs
    // Only authenticated admins can read click logs and aggregate analytics
    // No one can modify or delete existing click logs to preserve audit integrity
    match /clicks/{clickId} {
      allow create: if request.resource.data.keys().hasAll(['storeId', 'productId', 'timestamp'])
                    && request.resource.data.storeId is string
                    && request.resource.data.productId is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
